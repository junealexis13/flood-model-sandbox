# Optional overrides. Copy to .env only if you need one of these.
# This application does not use API keys, tokens, or passwords.
# Do not put secrets in this file.

# Directory where the API writes HAND rasters and hypsometric curves.
# When unset, a local run uses backend/data.
# Docker Compose sets this to /app/data inside the API container.
DATA_DIR=

# Prefix the browser uses for API calls.
# Leave empty so the UI calls /api on the same host:
# the Vite dev server proxies /api, and the Docker web image proxies /api.
VITE_API_BASE=
